# Copy to .env for local dev. In Vercel, set these under
# Project Settings → Environment Variables (they are baked in at build time,
# so a change requires a redeploy).

# ─── Supabase (required) ──────────────────────────────────────────────────────
# The anon key is safe to expose publicly; row-level security is what protects
# the data. Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── NestJS backend (apps/MVPLAB_BACKEND) ─────────────────────────────────────
# Defaults to /api/v1, which only resolves through the Vite dev proxy locally.
# Once the backend is hosted, set this to its absolute URL in Vercel, e.g.
# https://api.example.com/api/v1 — and add the Vercel domain to the backend's
# CORS allowlist. Until then, backend-backed features 404 in production.
VITE_API_BASE_URL=/api/v1

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:3001

# ─── Optional ─────────────────────────────────────────────────────────────────
# Public base URL shown to developers in the Dev Portal.
# VITE_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# Hosted documentation URL; falls back to the in-app /documentation route.
# VITE_DOCS_URL=https://docs.example.com
# VITE_STITCH_API_KEY=
