# Copy to .env for local dev.
# The admin panel talks to the same Supabase project and NestJS backend as the
# web app — admin capability comes from the signed-in user's role, not from a
# separate key. Never put a service_role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend (../backend). Defaults to /api/v1, which only resolves through the
# Vite dev proxy locally; set an absolute URL once the backend is hosted.
VITE_API_BASE_URL=/api/v1

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:3001
